# ================= CONFIGURATION =================
# From https://my.telegram.org  →  API development tools
API_ID=
API_HASH=

# Optional: default target group. You can also create/select it from the web UI.
GROUP_ID=-100

# ---- Optional overrides ----
# Persistent data dir (set to /data on Fly.io with a mounted volume).
# DATA_DIR=/data
# Root that "local path" scanning is confined to (Android/Termux default shown).
# SCAN_ROOT=~/storage/shared/DCIM
# MAX_CONCURRENT_UPLOADS=3
